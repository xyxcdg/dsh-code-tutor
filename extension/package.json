{
  "name": "dsh-window",
  "displayName": "DSH 问答窗口",
  "description": "在 VS Code 内嵌 DSH 问答窗口，并在旁边从最基础讲解你正在写的代码",
  "version": "0.0.2",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dshWindow.open",
    "onCommand:dshWindow.explainFile",
    "onCommand:dshWindow.explainSelection",
    "onCommand:dshWindow.toggleExplainOnSave"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "dshWindow.open", "title": "打开问答窗口", "category": "DSH" },
      { "command": "dshWindow.explainFile", "title": "讲解当前文件（从基础）", "category": "洄" },
      { "command": "dshWindow.explainSelection", "title": "讲解选中代码（从基础）", "category": "洄" },
      { "command": "dshWindow.toggleExplainOnSave", "title": "开关：保存时自动讲解", "category": "洄" }
    ],
    "keybindings": [
      { "command": "dshWindow.open", "key": "ctrl+alt+q" },
      { "command": "dshWindow.explainFile", "key": "ctrl+alt+e" },
      { "command": "dshWindow.explainSelection", "key": "ctrl+alt+shift+e" }
    ],
    "menus": {
      "editor/context": [
        { "command": "dshWindow.explainSelection", "when": "editorHasSelection", "group": "navigation@10" },
        { "command": "dshWindow.explainFile", "group": "navigation@11" }
      ]
    },
    "configuration": {
      "title": "DSH 问答窗口",
      "properties": {
        "dshWindow.dshPath": {
          "type": "string",
          "default": "",
          "description": "dsh.cmd 的完整路径。留空会自动在默认安装位置和 PATH 里查找（一般不用填，换电脑找不到时再填）。"
        },
        "dshWindow.explainOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存代码文件时，自动在旁边用「洄·讲解」从最基础讲解当前文件（同一文件只在内容变化时才讲解，避免重复消耗）。"
        }
      }
    }
  }
}
