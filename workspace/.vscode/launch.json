{
    "version": "0.2.0",
    "configurations": [
        { "name": "Python: 当前文件", "type": "debugpy", "request": "launch", "program": "${file}", "console": "integratedTerminal", "cwd": "${fileDirname}" },
        { "name": "Node: 当前文件", "type": "node", "request": "launch", "program": "${file}", "console": "integratedTerminal", "cwd": "${fileDirname}" },
        { "name": "C/C++: 当前文件 (gdb)", "type": "cppdbg", "request": "launch", "program": "${fileDirname}\\${fileBasenameNoExtension}.exe", "args": [], "stopAtEntry": false, "cwd": "${fileDirname}", "externalConsole": false, "MIMode": "gdb", "miDebuggerPath": "gdb.exe", "preLaunchTask": "C++: 编译当前文件" },
        { "name": "Java: 当前文件", "type": "jdk", "request": "launch", "mainClass": "${fileBasenameNoExtension}", "classPaths": ["${fileDirname}"], "console": "integratedTerminal", "cwd": "${fileDirname}" }
    ]
}
